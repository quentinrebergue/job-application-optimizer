# Database. `docker compose up -d db` reads POSTGRES_PASSWORD from the shell or from a `.env` file, and listens on 127.0.0.1:5433.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@127.0.0.1:5433/job_optimizer

# AI gateway (services/ai-gateway): run it locally with `AI_TOKEN=... ADDR=:8099 go run .`
AI_GATEWAY_URL=http://localhost:8099

# Password hashing: unset, passwords are hashed in the app. To use the password-hasher service (services/password-hasher):
#   ADDR=:8098 go run .   then   PASSWORD_HASHER_URL=http://localhost:8098
# PASSWORD_HASHER_URL=
# BCRYPT_QUEUE=150   how many logins and sign-ups may wait for a hash; production sets 30 (about 10 s at the rate of the service, #258)

# The local stack (`npm run stack`, scripts/stack.sh): everything has a default; uncomment to change it.
# DB_PORT=5433
# RENDERER_PORT=8090
# PDF_TEXT_PORT=8095
# HASHER_PORT=8098
# GATEWAY_PORT=8099
# APP_PORT=3000
# The AI gateway only starts with a key. Mistral, as in production (AI_MODEL: a dated name):
# AI_TOKEN=
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-small-2603
