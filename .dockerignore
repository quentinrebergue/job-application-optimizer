# Only what `next build` needs goes into the build context. Everything else
# makes the context bigger, can bust the COPY . . layer for nothing, and some
# of it must never be copied into an image (local Terraform state and vars).
node_modules
.next
.git
.github
.vscode
*.tsbuildinfo
npm-debug.log*
.DS_Store
.env*
!.env.example
coverage
data

# Other parts of the repository, built or applied separately
services
k8s
# The load tests (k6 scripts, results, and the sessions of the test accounts in load/.accounts.json)
load
terraform
ansible
scripts
docs

# Documentation and local tooling files
**/*.md
Dockerfile
docker-compose.yml
.dockerignore
