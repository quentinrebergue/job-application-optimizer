#!/bin/bash
set -euo pipefail

BACKUP_DIR=/home/debian/backups
mkdir -p "$BACKUP_DIR"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
cd /home/debian/app
docker compose exec -T db pg_dump -U app -d job_optimizer | gzip > "$BACKUP_DIR/job_optimizer-$TIMESTAMP.sql.gz"

# Keep only the 7 most recent backups
ls -1t "$BACKUP_DIR"/job_optimizer-*.sql.gz | tail -n +8 | xargs -r rm --
