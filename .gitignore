# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# raw project sources used for AI analysis only (kept local, not versioned)
/data/projects/

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform
terraform/terraform.tfvars
terraform/.terraform/
terraform/*.tfstate*
terraform/kubeconfig.yaml

# ansible
ansible/inventory.ini
# The encrypted vault of the secrets: kept on the owner's computer, not in Git (docs/security.md)
ansible/group_vars/app_servers/vault.yml

# AI ranking evaluation: real offers and library (personal data) and the results
/eval/private/
/eval/results/

# What scripts/export-removed-modules.sql writes (content of users)
removed-modules-*.json

# The accounts and the raw results of the load tests (sessions, run summaries)
/load/.accounts.json
/load/results/
